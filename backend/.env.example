# Пример переменных окружения для backend
# ==================================================
# Скопируйте файл в .env и заполните значениями.

# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DEBUG=true
DJANGO_ALLOWED_HOSTS=*
LANGUAGE_CODE=ru
TIME_ZONE=Asia/Tashkent

# База данных
DATABASE_URL=postgres://aibot:aibot@postgres:5432/aibot
CONN_MAX_AGE=60

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=django-db
CELERY_TASK_ALWAYS_EAGER=false

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ALLOWED_IDS=*

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TTS_MODEL=tts-1
OPENAI_WHISPER_MODEL=whisper-1

# Прочие провайдеры
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Биллинг
DEFAULT_CURRENCY=USD
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (anymail/SMTP)
DEFAULT_FROM_EMAIL=noreply@aibot.local
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# CORS
CORS_ALLOWED_ORIGINS=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_RATE=0.1
SENTRY_PROFILES_RATE=0.1
